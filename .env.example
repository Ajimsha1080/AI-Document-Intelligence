# ==============================================================================
# UAE Document Intelligence SaaS Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="UAE Document Intelligence Platform"
API_V1_STR=/api/v1
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# UAE Compliance & Data Sovereignty Guards
# When true, rejects any non-whitelisted outbound requests and external AI endpoints
STRICT_LOCAL_ONLY=true
ENFORCE_IN_COUNTRY_STORAGE=true
UAE_DATA_REGION="uae-north"

# Database (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@localhost:5432/uae_doc_intelligence
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis Queue & Cache
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO or S3-compatible in UAE Region)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=uae-documents
S3_REGION=uae-central

# Model Provider (local | uae_in_region | mock)
MODEL_PROVIDER_BACKEND=local
LOCAL_OCR_LANGUAGES=ara,eng
IN_REGION_API_ENDPOINT=https://uaenorth.api.cognitive.azure.com/

# Default Tenant Configuration
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_NAME="Al Hilal Banking & Capital"
DEFAULT_ADMIN_EMAIL=admin@alhilal-demo.ae
DEFAULT_ADMIN_PASSWORD=AdminSecurePass2026!
